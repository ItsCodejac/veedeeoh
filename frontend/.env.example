# Copy to frontend/.env and fill in. The build refuses to run without the two
# Supabase values -- there is no default, deliberately, because a default meant
# a self-hosted instance quietly used veedeeoh.com's database.
#
#   cp frontend/.env.example frontend/.env
#
# These are baked into the JavaScript bundle at build time, so they are public
# by definition. Only ever put the ANON key here. The service role key bypasses
# row-level security entirely and belongs on the server, in the repo-root .env.

# Required. Your own Supabase project, with supabase/migrations applied to it.
# Project settings -> API, or: supabase projects list
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional. The Cloudflare Worker that relays watch parties. Without it the
# app runs normally and the party screen says parties are not configured on
# this deployment, which is the honest answer rather than a broken button.
# See worker/ for the relay itself.
VITE_PARTY_WORKER_URL=

# Optional. Absolute base for the stream proxy, when it is not served from the
# same origin as the app. Leave blank to use this origin.
VITE_PROXY_URL=
