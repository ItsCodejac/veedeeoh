# Frontend build configuration. Copy to frontend/.env if you need any of it.
#
# SELF-HOSTING NEEDS NOTHING HERE. Build with no configuration and you get the
# self-host product: local storage, local profiles, no accounts. The build says
# which one it made -- "building SELF-HOST" or "building CLOUD".
#
# The variables below build the CLOUD product and are useless without a Supabase
# project of your own to point them at. They are documented because the repo
# builds both, not because self-hosting wants them.

# Cloud only. Compiled into the bundle, so anon key only, never the service role
# key. There is no default: absent means self-host, never "use veedeeoh's".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloud only. Watch parties are a cloud feature end to end -- the relay
# authenticates callers against the cloud project's JWT secret, so an instance
# with no cloud has no identity for it to verify. The party tab is hidden
# without it rather than shown and broken.
VITE_PARTY_WORKER_URL=

# Either product. Absolute base for the stream proxy when it is not served from
# the same origin as the app.
VITE_PROXY_URL=
