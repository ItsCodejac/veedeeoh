# Self-hosting configuration. Copy to .env in this directory and fill in.
#
#   cp .env.example .env
#   docker compose up --build
#
# Only the first two are required. Everything else here is for features a
# self-hosted instance does not need: billing, transactional email and the
# scheduled jobs are part of the hosted deployment, and those endpoints answer
# 501 explaining themselves rather than failing oddly.
#
# Full walkthrough, including creating the database: frontend/self-hosting.html

# ---- required ---------------------------------------------------------------
# Your own Supabase project, with supabase/migrations applied to it. Both are
# compiled into the frontend bundle and are public by design; row-level
# security is what protects the data, which is why the migrations matter.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# ---- optional ---------------------------------------------------------------
# Needed only by account deletion, which has to remove a user from auth.users.
# BYPASSES ROW-LEVEL SECURITY. Server-side only -- never a build arg, never
# anything with a VITE_ prefix, since those are compiled into public JavaScript.
SUPABASE_SERVICE_ROLE_KEY=

# The Cloudflare Worker that relays watch parties, if you run one. See worker/.
# Left blank, the app runs normally and the party screen says parties are not
# configured on this deployment.
PARTY_WORKER_URL=

# Absolute base for the stream proxy when it is not served from this origin.
PROXY_URL=
