# Self-hosting configuration.
#
#   docker compose up --build
#
# EVERYTHING HERE IS OPTIONAL. A self-hosted veedeeoh is standalone: no account
# with us, no database, no API key, no calls to anything we run. If you set none
# of this it works, which is the intended way to run it.
#
# There is deliberately nothing about Supabase in this file. Supabase is the
# cloud product's database, and the cloud product is what the $4 pays for --
# accounts, syncing between devices, watch parties. Self-host keeps its state in
# a JSON store on your own machine and needs none of it.
#
# Guide: frontend/self-hosting.html

# Port the server listens on.
PORT=8321

# Absolute base for the stream proxy, when it is not served from the same
# origin as the app. Leave blank to use this origin.
PROXY_URL=
