{
  "buildCommand": "npm run build",
  "outputDirectory": "src/tvlc/static",
  "routes": [
    {
      "src": "/",
      "dest": "/landing.html"
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html"
    },
    {
      "src": "/terms",
      "dest": "/terms.html"
    },
    {
      "src": "/self-hosting",
      "dest": "/self-hosting.html"
    },
    {
      "src": "/404",
      "dest": "/404.html"
    },
    {
      "src": "/change-password",
      "dest": "/change-password.html"
    },
    {
      "src": "/auth/confirm",
      "dest": "/auth-confirm.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.ts"
    },
    {
      "src": "/proxy",
      "dest": "/api/proxy.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/assets/(.*)",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/catalog-warm",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/trial-emails",
      "schedule": "0 15 * * *"
    }
  ]
}
